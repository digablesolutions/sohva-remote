<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.BraviaRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!-- Launch splash: the mark on black, the same on Android 8-11 as the system one on 12+.
         Not held after the first frame: the remote should be there at once. -->
    <style name="Theme.BraviaRemote.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BraviaRemote</item>
    </style>
</resources>
