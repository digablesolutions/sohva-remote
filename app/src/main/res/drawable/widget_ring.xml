<?xml version="1.0" encoding="utf-8"?>
<!-- A round key with a hairline, like the power key on the remote screen. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/widget_ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="@android:color/transparent" />
            <stroke android:width="1.5dp" android:color="@color/widget_outline" />
        </shape>
    </item>
</ripple>
