<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local-network control of the TV: HTTP to the TV, SSDP multicast, Wake-on-LAN. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The sleep timer's one-minute fade runs as a short foreground service with a wake lock. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- A restart drops alarms: set the wake-up and sleep timer again. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Optional: the remote as a notification (and the timers' progress). Asked for when turned on. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Optional: mute the TV during phone calls. Asked for only when that setting is turned on. -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- Sleep timer, wake-up and scheduled scenes on time with the app closed. Play allows
         USE_EXACT_ALARM only for alarm and calendar apps, so the user grants this one in settings. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Lets "Type on TV" find the phone's speech recognizer (package visibility, Android 11+). -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.speech.action.RECOGNIZE_SPEECH" />
        </intent>
    </queries>

    <application
        android:name=".BraviaRemoteApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.BraviaRemote">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.BraviaRemote.Starting"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity,DiscouragedApi"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".data.SleepTimerReceiver"
            android:exported="false" />

        <service
            android:name=".data.SleepFadeService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <receiver
            android:name=".data.WakeUpReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.SceneAlarmReceiver"
            android:exported="false" />

        <receiver
            android:name=".data.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".data.WakeUpService"
            android:exported="false"
            android:foregroundServiceType="shortService" />

        <!-- Exported: the phone-state broadcast comes from the system. -->
        <receiver
            android:name=".data.CallMuteReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.PHONE_STATE" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".shortcuts.RemoteWidget"
            android:exported="false"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_remote_info" />
        </receiver>

        <service
            android:name=".shortcuts.PowerTile"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="@string/tile_power"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".shortcuts.MuteTile"
            android:exported="true"
            android:icon="@drawable/ic_volume_off"
            android:label="@string/tile_mute"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".shortcuts.SceneTile"
            android:exported="true"
            android:icon="@drawable/ic_scene"
            android:label="@string/tile_scene"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".shortcuts.GuideTile"
            android:exported="true"
            android:icon="@drawable/ic_guide"
            android:label="@string/tile_guide"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
    </application>
</manifest>
